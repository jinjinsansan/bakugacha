# ================================================================
# 爆ガチャ 環境変数テンプレート
# .env.local にコピーして値を設定してください (このファイルに実値を書かないこと)
# ================================================================

# ── Supabase (必須) ───────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # 秘密。クライアントに絶対に渡さない
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── サイト (必須) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001   # 本番は https://ドメイン

# ── Cloudflare R2 (必須: 画像/動画配信) ─────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                   # 秘密
R2_SECRET_ACCESS_KEY=               # 秘密
R2_BUCKET_NAME=bakugacha
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=     # 例: https://pub-xxxx.r2.dev

# ── LINE (必須: ログイン・Webhook・通知) ────────────────────────
LINE_CHANNEL_SECRET=                # 秘密。Webhook 署名検証に必須
LINE_CHANNEL_ACCESS_TOKEN=          # 秘密
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=          # 秘密
NEXT_PUBLIC_LINE_OFFICIAL_URL=      # 例: https://lin.ee/xxxx
LINE_REWARD_COINS=300               # 友だち追加ボーナス (省略可)

# ── 管理者 (必須) ─────────────────────────────────────────────
ADMIN_EMAILS=                       # カンマ区切り: admin@example.com,owner@example.com
ADMIN_LINE_IDS=                     # カンマ区切り: U1234...,Uabcd...

# ── 外部連携 ──────────────────────────────────────────────────
KREWARD_SECRET=                     # 秘密。kreward API 認証
KREWARD_MAX_COINS=100000            # 省略可

# ── Vercel Cron ───────────────────────────────────────────────
CRON_SECRET=                        # 秘密。/api/cron/* の認証 (Vercel が自動送信)

# ── 機能フラグ (通常は未設定) ────────────────────────────────────
# ENABLE_SHELVED_GACHA=1            # お蔵入りガチャの API を有効化

# ── 復旧スクリプト用 (本番には設定しない) ─────────────────────────
# RECOVERY_SUPABASE_URL=
# RECOVERY_SUPABASE_SERVICE_ROLE_KEY=
