# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling state (Supabase CLI / Serena)
/supabase/.temp/
/.serena/

# 大容量メディア（R2/CDN 配信のため git では管理しない）
# 動画は NEXT_PUBLIC_GACHA_ASSET_BASE_URL 経由で配信される。
# public/ 配下のみ意図的に追跡する例外とする。
*.mp4
*.mov
*.zip
!/public/**

# リポジトリルートに散在するガチャ映像ソースフォルダ（R2 アップロード元）
/競馬ガチャ映像/
/競馬ガチャカード/
/ROYALカード映像やり直し版/
/エレベーターガチャ映像/
/修正フォルダ/
